# PHP 7.3 branch pins (build-ext.sh: PHP73_<PIN>_* override the generic pins) [calc]
#   redis >= 6.1 needs PHP >= 7.4 → 6.0.2 (min 7.2); xdebug 3.2+ needs 8.0 → 3.1.6 (7.2–8.1).
#   apcu 5.1.28 / yaml 2.3.0 / imagick 3.8.1 / memcached 3.4.0 declare PHP >= 7.0/7.1/5.6/7.0 → generic pins.
PHP73_PECL_REDIS_VERSION=6.0.2
PHP73_PECL_REDIS_URL=https://pecl.php.net/get/redis-6.0.2.tgz
PHP73_PECL_REDIS_SHA256=01aeccb0e14f897fe56f0509be6e6991ff0ad459f9d34e95e4556d02699b9a03
PHP73_XDEBUG_VERSION=3.1.6
PHP73_XDEBUG_URL=https://pecl.php.net/get/xdebug-3.1.6.tgz
PHP73_XDEBUG_SHA256=554eca0b4d5b7b93cb2258fab0b0bd84cc8721e74322a2255c14e137cbcad5d2
# PHP 7.4 branch pins [calc]: redis 6.3.0 declares PHP >= 7.4 → generic pin; apcu/yaml/imagick/
#   memcached generic pins; only xdebug needs 3.1.6 (3.2+ needs PHP 8.0).
PHP74_XDEBUG_VERSION=3.1.6
PHP74_XDEBUG_URL=https://pecl.php.net/get/xdebug-3.1.6.tgz
PHP74_XDEBUG_SHA256=554eca0b4d5b7b93cb2258fab0b0bd84cc8721e74322a2255c14e137cbcad5d2

