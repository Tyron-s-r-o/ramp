# PHP support phases → manifest `support` (active|security|eol) + `eolDate` (end of security support).
# php.net/supported-versions.php, verified 2026-09-25. First launch installs only active/security branches
# (+ the one phpMyAdmin needs); EOL branches are installed on demand (PHP › Pridať verziu PHP, MAMP import).
PHP85_SUPPORT=active;   PHP85_EOL=2029-12-31
PHP84_SUPPORT=active;   PHP84_EOL=2028-12-31
PHP83_SUPPORT=security; PHP83_EOL=2027-12-31
PHP82_SUPPORT=security; PHP82_EOL=2026-12-31
PHP81_SUPPORT=eol;      PHP81_EOL=2025-12-31
PHP74_SUPPORT=eol;      PHP74_EOL=2022-11-28
PHP73_SUPPORT=eol;      PHP73_EOL=2021-12-06

