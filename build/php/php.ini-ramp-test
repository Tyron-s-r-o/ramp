; Minimal php.ini used by verify-php.sh (build self-test) and smoke-fpm.sh.
; Placeholders are rendered by render_test_ini (build/php/verify-php.sh):
;   @EXTENSION_DIR@   absolute path of <php-root>/<ramp.json extension_dir_rel>
;   @OPCACHE_LINE@    "zend_extension=opcache" (shared opcache, PHP <= 8.4) or empty (8.5+: built in)
; The real per-install php.ini is generated by the app (Phase 4).
extension_dir = "@EXTENSION_DIR@"
@OPCACHE_LINE@
date.timezone = Europe/Bratislava
memory_limit = 256M
display_errors = On
error_reporting = E_ALL

opcache.enable = 1
opcache.enable_cli = 1
opcache.memory_consumption = 64
opcache.validate_timestamps = 1
