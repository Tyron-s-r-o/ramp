// Distribution settings for RAMP.app (08-03) — used by Debug and Release (project.yml configFiles).
// NOTE: "//" starts a comment in xcconfig files → URLs are written as https:/$()/host/…
//
// TODO(08-02/08-03 checkpoints): replace OWNER with the real GitHub owner once the repositories exist.

// Sparkle appcast (EdDSA-signed feed, published with every app release — app-release.yml)
RAMP_APPCAST_URL = https:/$()/getramp.net/appcast.xml

// Sparkle EdDSA public key (base64) printed by Sparkle's `generate_keys` — PLACEHOLDER.
// app/scripts/release-app.sh refuses to build a release while this still starts with TODO.
RAMP_SPARKLE_PUBLIC_KEY = TODO_SPARKLE_PUBLIC_KEY

// Default service manifest for fresh installs (ramp.json without manifestURL); existing configs untouched.
// Empty or containing OWNER = not configured (the app then needs RAMP_DEV_MANIFEST / rampctl install).
RAMP_MANIFEST_URL = https:/$()/getramp.net/manifest.json

// Monotonic integer → CFBundleVersion (Sparkle compares it). release-app.sh passes RAMP_BUILD_NUMBER=<n>.
RAMP_BUILD_NUMBER = 1
